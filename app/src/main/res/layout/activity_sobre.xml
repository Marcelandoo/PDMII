<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/iddrawer3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".sobre">

    <LinearLayout
        android:id="@+id/filho2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:minHeight="?attr/actionBarSize"
            android:theme="?attr/actionBarTheme"
            app:title="Sobre" />

        <TextView
            android:id="@+id/textView14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text=" Me chamo Marcelo Henrico Ferreira, eu tenho 18 anos e estudo no Instituto Federal do Sul de Minas Gerais - Campus Poços de Caldas."
            android:textSize="20sp" />

        <TextView
            android:id="@+id/textView15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text=" Tento ser feliz. :)"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/imageView14"
            android:layout_width="262dp"
            android:layout_height="272dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="180dp"
            android:layout_marginBottom="100dp"
            app:srcCompat="@drawable/coitado2" />

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/cabecarioi"
        app:menu="@menu/menu" />
</androidx.drawerlayout.widget.DrawerLayout>